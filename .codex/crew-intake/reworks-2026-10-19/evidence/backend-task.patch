+import { Injectable } from '@nestjs/common';
+import Ajv2020 from 'ajv/dist/2020';
+import type { AnySchema, ErrorObject, ValidateFunction } from 'ajv';
+import { DateTime } from 'luxon';
+import {
+	isContractValue,
+	isPlainRecord,
+} from '../../../common/validation/json-contract.validators';
+import {
+	PrintoutRequiredOptionsDto,
+	type PrintoutDefinition,
+} from '../types/printout-definition.contracts';
+import type { PrintoutFieldError } from '../types/printout-workflow.types';
+
+const escapePointer = (value: string) =>
+	value.replace(/~/gu, '~0').replace(/\//gu, '~1');
+function fieldError(error: ErrorObject): PrintoutFieldError {
+	const property =
+		error.keyword === 'required'
+			? (error.params as { missingProperty: string }).missingProperty
+			: error.keyword === 'additionalProperties'
+				? (error.params as { additionalProperty: string }).additionalProperty
+				: undefined;
+	return {
+		path: `${error.instancePath}${property === undefined ? '' : `/${escapePointer(property)}`}`,
+		keyword: error.keyword,
+		message: error.message ?? 'Invalid value',
+	};
+}
+
+function propertyAt(
+	schema: Record<string, unknown>,
+	path: string,
+): Record<string, unknown> | undefined {
+	if (!path.startsWith('/') || /~(?![01])/u.test(path)) return undefined;
+	let current = schema;
+	for (const encoded of path.slice(1).split('/')) {
+		const key = encoded.replace(/~1/gu, '/').replace(/~0/gu, '~');
+		if (
+			['__proto__', 'prototype', 'constructor'].includes(key) ||
+			!isPlainRecord(current.properties) ||
+			!Object.hasOwn(current.properties, key)
+		)
+			return undefined;
+		const next: unknown = current.properties[key];
+		if (!isPlainRecord(next)) return undefined;
+		current = next;
+	}
+	return current;
+}
+function leafPaths(schema: Record<string, unknown>, prefix = ''): string[] {
+	if (schema.type !== 'object' || !isPlainRecord(schema.properties))
+		return [prefix];
+	return Object.entries(schema.properties).flatMap(([key, value]) =>
+		isPlainRecord(value)
+			? leafPaths(value, `${prefix}/${escapePointer(key)}`)
+			: [],
+	);
+}
+
+function validChoices(schema: Record<string, unknown>): boolean {
+	const type = schema.type;
+	if (!['string', 'number', 'integer'].includes(type as string)) return false;
+	const choices: unknown[] | undefined = Array.isArray(schema.oneOf)
+		? schema.oneOf.map((choice: unknown) =>
+				isPlainRecord(choice) && Object.hasOwn(choice, 'const')
+					? choice.const
+					: undefined,
+			)
+		: Array.isArray(schema.enum)
+			? schema.enum
+			: undefined;
+	return (
+		Boolean(choices?.length) &&
+		choices!.every((choice) =>
+			type === 'string'
+				? typeof choice === 'string'
+				: typeof choice === 'number' &&
+					Number.isFinite(choice) &&
+					(type !== 'integer' || Number.isInteger(choice)),
+		) &&
+		new Set(choices).size === choices!.length
+	);
+}
+
+/** Compiles only application-owned schemas; never accepts executable client definitions. */
+@Injectable()
+export class PrintoutDefinitionValidator {
+	private readonly ajv = new Ajv2020({
+		allErrors: true,
+		strict: true,
+		coerceTypes: false,
+		useDefaults: false,
+		removeAdditional: false,
+	}).addFormat('date', (value: string) => {
+		if (!/^\d{4}-\d{2}-\d{2}$/u.test(value)) return false;
+		const date = DateTime.fromISO(value);
+		return date.isValid && date.toISODate() === value;
+	});
+	private readonly compiled = new WeakMap<
+		PrintoutDefinition,
+		ValidateFunction
+	>();
+
+	assertDefinition(definition: PrintoutDefinition): void {
+		if (this.compiled.has(definition)) return;
+		const { code, ...projection } = definition;
+		if (
+			!/^[a-z][a-z0-9-]*$/u.test(code) ||
+			!isContractValue(PrintoutRequiredOptionsDto, projection)
+		)
+			throw new Error(`Invalid printout definition envelope: ${code}`);
+		const schema = definition.optionsSchema;
+		if (
+			schema.$schema !== 'https://json-schema.org/draft/2020-12/schema' ||
+			schema.type !== 'object' ||
+			schema.additionalProperties !== false ||
+			schema.$async !== undefined
+		)
+			throw new Error(`Unsupported printout schema: ${code}`);
+		const validate = this.ajv.compile(schema as AnySchema);
+		const fields = definition.optionsUi.sections.flatMap(
+			(section) => section.fields,
+		);
+		const paths = new Set<string>();
+		const sectionIds = new Set<string>();
+		for (const section of definition.optionsUi.sections) {
+			if (sectionIds.has(section.id))
+				throw new Error(`Duplicate printout section: ${code}`);
+			sectionIds.add(section.id);
+		}
+		for (const field of fields) {
+			const target = propertyAt(schema, field.path);
+			if (
+				!target ||
+				paths.has(field.path) ||
+				typeof target.title !== 'string' ||
+				!target.title.trim()
+			)
+				throw new Error(`Invalid printout option path: ${code}${field.path}`);
+			paths.add(field.path);
+			const types: Record<string, string[]> = {
+				text: ['string'],
+				textarea: ['string'],
+				date: ['string'],
+				number: ['number', 'integer'],
+				select: ['string', 'number', 'integer'],
+				multiSelect: ['array'],
+				selectButton: ['string', 'number', 'integer', 'array'],
+				checkbox: ['boolean'],
+				switch: ['boolean'],
+			};
+			if (!types[field.control]?.includes(target.type as string))
+				throw new Error(`Incompatible printout control: ${code}${field.path}`);
+			if (field.control === 'date' && target.format !== 'date')
+				throw new Error(
+					`Date control requires a calendar-date schema: ${code}${field.path}`,
+				);
+			if (['select', 'selectButton', 'multiSelect'].includes(field.control)) {
+				const choices = target.type === 'array' ? target.items : target;
+				if (!isPlainRecord(choices) || !validChoices(choices))
+					throw new Error(`Missing printout choices: ${code}${field.path}`);
+			}
+		}
+		if (leafPaths(schema).some((path) => !paths.has(path)))
+			throw new Error(`Unrendered printout field: ${code}`);
+		validate(definition.initialValues);
+		if (validate.errors?.some((error) => error.keyword !== 'required'))
+			throw new Error(`Invalid printout initial values: ${code}`);
+		this.compiled.set(definition, validate);
+	}
+
+	errors(
+		definition: PrintoutDefinition,
+		values: Record<string, unknown>,
+	): PrintoutFieldError[] {
+		this.assertDefinition(definition);
+		const validate = this.compiled.get(definition)!;
+		validate(values);
+		return (validate.errors ?? []).map(fieldError);
+	}
+}

