+import { Type } from 'class-transformer';
+import {
+	ArrayUnique,
+	IsArray,
+	IsIn,
+	IsInt,
+	IsObject,
+	IsOptional,
+	IsString,
+	Matches,
+	Min,
+	MinLength,
+	ValidateNested,
+} from 'class-validator';
+import { PreserveJsonValue } from '../../../common/validation/json-contract.validators';
+
+export const PRINTOUT_FORMATS = ['pdf', 'docx', 'xlsx'] as const;
+export type PrintoutFormat = (typeof PRINTOUT_FORMATS)[number];
+export const PRINTOUT_CONTROLS = [
+	'text',
+	'textarea',
+	'number',
+	'select',
+	'multiSelect',
+	'selectButton',
+	'checkbox',
+	'switch',
+	'date',
+] as const;
+export type PrintoutControl = (typeof PRINTOUT_CONTROLS)[number];
+
+export class PrintoutOptionFieldDto {
+	@IsString() @Matches(/^\/(?:[^~]|~[01])+$/u) path!: string;
+	@IsIn(PRINTOUT_CONTROLS) control!: PrintoutControl;
+	@IsOptional() @IsString() suffix?: string;
+}
+export class PrintoutOptionSectionDto {
+	@IsString() @MinLength(1) id!: string;
+	@IsString() @MinLength(1) label!: string;
+	@IsArray()
+	@ValidateNested({ each: true })
+	@Type(() => PrintoutOptionFieldDto)
+	fields!: PrintoutOptionFieldDto[];
+}
+export class PrintoutOptionsUiDto {
+	@IsArray()
+	@ValidateNested({ each: true })
+	@Type(() => PrintoutOptionSectionDto)
+	sections!: PrintoutOptionSectionDto[];
+}
+/** Code-owned JSONB projection. Option leaf constraints belong exclusively to optionsSchema. */
+export class PrintoutRequiredOptionsDto {
+	@PreserveJsonValue() @IsInt() @Min(1) definitionVersion!: number;
+	@IsArray()
+	@ArrayUnique()
+	@IsIn(PRINTOUT_FORMATS, { each: true })
+	supportedFormats!: PrintoutFormat[];
+	@PreserveJsonValue() @IsObject() optionsSchema!: Record<string, unknown>;
+	@ValidateNested()
+	@Type(() => PrintoutOptionsUiDto)
+	optionsUi!: PrintoutOptionsUiDto;
+	@PreserveJsonValue() @IsObject() initialValues!: Record<string, unknown>;
+}
+
+export type PrintoutDefinition = PrintoutRequiredOptionsDto & { code: string };

