+import { DOCUMENT } from '@angular/common';
+import { inject, Injectable } from '@angular/core';
+import { ConfirmationService } from 'primeng/api';
+
+/** Resolves only after an explicit choice; a new request cancels the old choice. */
+@Injectable({ providedIn: 'root' })
+export class Confirmations {
+	private readonly prime = inject(ConfirmationService);
+	private readonly document = inject(DOCUMENT);
+	private kind: 'popup' | 'dialog' | null = null;
+	private finish: ((accepted: boolean) => void) | null = null;
+	confirm(message: string, event?: Event, dialog = false): Promise<boolean> {
+		this.dismiss();
+		const eventTarget =
+			event?.target instanceof Element
+				? event.target.closest('button,[role="menuitem"]')
+				: null;
+		const target =
+			event?.currentTarget instanceof HTMLElement
+				? event.currentTarget
+				: (eventTarget ?? this.document.activeElement);
+		return new Promise<boolean>((resolve) => {
+			this.finish = resolve;
+			this.kind = dialog ? 'dialog' : 'popup';
+			this.prime.confirm({
+				key: dialog ? 'dialog' : 'popup',
+				message,
+				header: 'Confirm',
+				target: target instanceof HTMLElement ? target : this.document.body,
+				acceptLabel: 'Confirm',
+				rejectLabel: 'Cancel',
+				accept: () => this.settle(true),
+				reject: () => this.settle(false),
+			});
+		});
+	}
+	dismissDialog(): void {
+		if (this.kind === 'dialog') this.settle(false);
+	}
+	dismissPopup(): void {
+		if (this.kind === 'popup') this.settle(false);
+	}
+	dismiss(): void {
+		this.settle(false);
+		this.prime.close();
+	}
+	private settle(accepted: boolean): void {
+		const finish = this.finish;
+		this.finish = null;
+		this.kind = null;
+		finish?.(accepted);
+	}
+}

