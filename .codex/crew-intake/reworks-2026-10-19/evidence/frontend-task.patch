+import '@angular/compiler';
+import { expect, it } from 'bun:test';
+import {
+	createEnvironmentInjector,
+	Injector,
+	type EnvironmentInjector,
+} from '@angular/core';
+import { firstValueFrom, of, Subject } from 'rxjs';
+import {
+	FabricationService,
+	type AssignmentResult,
+	type FabricationBatch,
+} from '@planicam/fabrication/data-access';
+import { FabricationStore } from './fabrication.store';
+
+for (const outcome of ['success', 'failure'] as const) {
+	it(`preserves the newly selected Batch after an older assignment ${outcome}`, async () => {
+		const assignment = new Subject<AssignmentResult>();
+		const reads: string[] = [];
+		const batch = (id: string): FabricationBatch => ({
+			id,
+			version: 1,
+			name: id,
+			number: id,
+			status: 'PLANNING',
+			responsiblePerson: null,
+			description: null,
+			deploymentDate: null,
+			archivedAt: null,
+			createdAt: '',
+			updatedAt: '',
+			elementCount: 0,
+			elements: [],
+		});
+		const injector = createEnvironmentInjector(
+			[
+				FabricationStore,
+				{
+					provide: FabricationService,
+					useValue: {
+						detail: (id: string) => {
+							reads.push(id);
+							return of(batch(id));
+						},
+						list: () => of({ items: [], total: 0, page: 1, pageSize: 100 }),
+						assign: () => assignment,
+					},
+				},
+			],
+			Injector.NULL as EnvironmentInjector,
+		);
+		try {
+			const store = injector.get(FabricationStore);
+			store.select('batch-A');
+			const pending = firstValueFrom(
+				store.assign('batch-A', 1, { projectIds: ['project'] }),
+			);
+			store.select('batch-B');
+			if (outcome === 'success') {
+				assignment.next({
+					id: 'batch-A',
+					version: 2,
+					assigned: [],
+					skipped: [],
+				});
+				assignment.complete();
+			} else assignment.error(new Error('Failure belongs to Batch A'));
+			expect((await pending).kind).toBe(outcome);
+			expect(store.selectedId()).toBe('batch-B');
+			expect(store.selected()?.id).toBe('batch-B');
+			expect(reads).toEqual(['batch-A', 'batch-B']);
+			expect(store.saving()).toBe(false);
+			expect(store.error()).toBe(null);
+		} finally {
+			injector.destroy();
+		}
+	});
+}
