+
+/** Resolve physical identities without broadening an explicit Element or batch subset. */
+export function loadPrintoutElements(
+	http: HttpClient,
+	context: PrintoutSelectionContext,
+	resolution: PrintoutContextResolution,
+): Observable<readonly PrintoutElement[]> {
+	const restricted =
+		context.inputType === 'ELEMENTS' ||
+		context.inputType === 'FABRICATION_BATCH';
+	const allowed = new Set(resolution.elementIds);
+	return from(resolution.positions).pipe(
+		mergeMap(
+			(position) =>
+				http
+					.get<unknown>('/api/positions/' + encodeURIComponent(position.id))
+					.pipe(
+						map((response) => {
+							const detail = readApiData(
+								response,
+								(value): value is Record<string, unknown> =>
+									isRecord(value) &&
+									value['id'] === position.id &&
+									Array.isArray(value['elements']) &&
+									isRecord(value['system']),
+							);
+							if (detail['archivedAt'] || detail['projectArchivedAt'])
+								return [];
+							const system = detail['system'] as Record<string, unknown>,
+								design = detail['design'],
+								input =
+									isRecord(design) && isRecord(design['input'])
+										? design['input']
+										: {};
+							return (detail['elements'] as unknown[]).flatMap((value) => {
+								if (
+									!isRecord(value) ||
+									typeof value['id'] !== 'string' ||
+									typeof value['number'] !== 'string' ||
+									typeof value['isExcluded'] !== 'boolean'
+								)
+									throw new Error('Invalid physical element');
+								if (
+									value['isExcluded'] ||
+									(restricted && !allowed.has(value['id']))
+								)
+									return [];
+								return [
+									{
+										id: value['id'],
+										number: value['number'],
+										positionId: position.id,
+										name: position.name,
+										type: String(detail['type'] ?? ''),
+										systemId: String(system['id'] ?? ''),
+										systemName: String(system['name'] ?? ''),
+										dimensions:
+											typeof input['widthMillimeters'] === 'number' &&
+											typeof input['heightMillimeters'] === 'number'
+												? input['widthMillimeters'] +
+													' × ' +
+													input['heightMillimeters'] +
+													' mm'
+												: 'Not initialized',
+										thumbnailKey: String(detail['thumbnailKey'] ?? ''),
+									},
+								];
+							});
+						}),
+					),
+			6,
+		),
+		toArray(),
+		map((groups) => {
+			const values = new Map<string, PrintoutElement>();
+			for (const group of groups)
+				for (const item of group) values.set(item.id, item);
+			return [...values.values()].sort((a, b) =>
+				a.number.localeCompare(b.number),
+			);
+		}),
+	);
+}

