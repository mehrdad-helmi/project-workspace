+import {
+	ChangeDetectionStrategy,
+	Component,
+	input,
+	output,
+} from '@angular/core';
+import {
+	OptionsControl,
+	type ControlChoice,
+} from '@planicam/shared/ui/options-control';
+import { InlineMessage, DividerLine } from '@planicam/shared/ui/status';
+import {
+	optionAt,
+	optionSchema,
+	withOption,
+	definitionProblem,
+	type PrintoutType,
+	type PrintoutFieldError,
+	type PrintoutUiField,
+} from '@planicam/hub/state';
+@Component({
+	selector: 'planicam-printout-options',
+	imports: [OptionsControl, InlineMessage, DividerLine],
+	changeDetection: ChangeDetectionStrategy.OnPush,
+	templateUrl: './printout-options.component.html',
+	styleUrl: './printout-options.component.scss',
+})
+export class PrintoutOptions {
+	readonly definition = input.required<PrintoutType>();
+	readonly values = input.required<Readonly<Record<string, unknown>>>();
+	readonly errors = input<readonly PrintoutFieldError[]>([]);
+	readonly disabled = input(false);
+	readonly changed = output<Readonly<Record<string, unknown>>>();
+	protected problem(): string | null {
+		return definitionProblem(this.definition());
+	}
+	protected schema(field: PrintoutUiField): Readonly<Record<string, unknown>> {
+		return optionSchema(this.definition(), field.path);
+	}
+	protected value(field: PrintoutUiField): unknown {
+		return optionAt(this.values(), field.path);
+	}
+	protected label(field: PrintoutUiField): string {
+		return String(this.schema(field)['title'] ?? field.path);
+	}
+	protected hint(field: PrintoutUiField): string {
+		return String(this.schema(field)['description'] ?? '');
+	}
+	protected required(field: PrintoutUiField): boolean {
+		const parts = field.path.split('/');
+		const leaf = parts.pop()?.replace(/~1/gu, '/').replace(/~0/gu, '~') ?? '';
+		const parent =
+			parts.length === 1
+				? this.definition().optionsSchema
+				: optionSchema(this.definition(), parts.join('/'));
+		return (
+			Array.isArray(parent?.['required']) &&
+			(parent['required'] as unknown[]).includes(leaf)
+		);
+	}
+	protected choices(field: PrintoutUiField): ControlChoice[] {
+		const schema = this.schema(field);
+		const source =
+			schema['type'] === 'array' &&
+			schema['items'] &&
+			typeof schema['items'] === 'object'
+				? (schema['items'] as Record<string, unknown>)
+				: schema;
+		const oneOf = source['oneOf'];
+		if (Array.isArray(oneOf))
+			return oneOf.map((row) => ({
+				label: String(row.title ?? row.const),
+				value: row.const as string | number,
+			}));
+		const values = source['enum'];
+		return Array.isArray(values)
+			? values.map((value) => ({
+					label: String(value),
+					value: value as string | number,
+				}))
+			: [];
+	}
+	protected error(field: PrintoutUiField): string {
+		return this.errors()
+			.filter((error) => error.path === field.path)
+			.map((error) => error.message)
+			.join(' ');
+	}
+	protected number(field: PrintoutUiField, key: string): number | undefined {
+		const value = this.schema(field)[key];
+		return typeof value === 'number' ? value : undefined;
+	}
+	protected set(field: PrintoutUiField, value: unknown): void {
+		this.changed.emit(withOption(this.values(), field.path, value));
+	}
+}

