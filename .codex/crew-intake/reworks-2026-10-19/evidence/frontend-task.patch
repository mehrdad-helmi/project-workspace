+import {
+	ChangeDetectionStrategy,
+	Component,
+	input,
+	model,
+	output,
+} from '@angular/core';
+import { Dialog as PrimeDialog } from 'primeng/dialog';
+
+/** Modal ownership stays with its feature; PrimeNG owns focus, mask and escape. */
+@Component({
+	selector: 'pl-dialog',
+	imports: [PrimeDialog],
+	changeDetection: ChangeDetectionStrategy.OnPush,
+	template: `<p-dialog
+		[visible]="visible()"
+		(visibleChange)="requestClose($event)"
+		[header]="title()"
+		[showHeader]="!!title()"
+		[modal]="true"
+		[draggable]="false"
+		[resizable]="false"
+		closeAriaLabel="Close"
+		[closable]="!busy()"
+		[closeOnEscape]="!busy()"
+		[blockScroll]="true"
+		appendTo="body"
+		[style]="{ width: width() + 'px', maxWidth: '94vw', maxHeight: '92vh' }"
+		[contentStyle]="{ overflow: 'auto', minWidth: '0' }"
+		><ng-content
+	/></p-dialog>`,
+})
+export class Dialog {
+	readonly title = input('');
+	readonly width = input(960);
+	readonly busy = input(false);
+	readonly visible = model(false);
+	readonly cancelled = output<Event>();
+	showModal(): void {
+		this.visible.set(true);
+	}
+	close(): void {
+		this.visible.set(false);
+	}
+	protected requestClose(visible: boolean): void {
+		if (visible || this.busy()) return;
+		const event = new Event('cancel', { cancelable: true });
+		this.cancelled.emit(event);
+		if (!event.defaultPrevented) this.close();
+	}
+}

