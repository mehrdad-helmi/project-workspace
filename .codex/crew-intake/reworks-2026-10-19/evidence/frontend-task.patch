+function fieldError(error: ErrorObject): PrintoutFieldError {
+	const property =
+		error.keyword === 'required'
+			? String(error.params['missingProperty'])
+			: error.keyword === 'additionalProperties'
+				? String(error.params['additionalProperty'])
