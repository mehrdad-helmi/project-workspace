+					[value]="model().modelDescription"
+					(valueChange)="text('modelDescription', $event)"
+				/>
+			</section>
+			@if (!editing()) {
+				<section class="geometry">
+					<h3 class="pl-label">System</h3>
+					<div class="system-grid">
+						<pl-select
+							label="Position Type"
+							[field]="fields.type"
+							[options]="catalog.options()['positionTypes'] ?? []"
