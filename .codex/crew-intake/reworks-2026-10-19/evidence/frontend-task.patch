+		expect(s.selectedReportIds()).toEqual([]);
+		f.injector.destroy();
+	});
+	it('cancels an in-flight result when the input context changes', () => {
+		const f = fixture(),
+			s = f.store;
+		s.load(query);
+		s.selectReports(['fixture'], true);
+		s.formats('fixture', ['pdf']);
+		s.selectElements(['element-1'], true);
+		s.generate();
+		expect(s.saving()).toBe(true);
+		s.load({ ...query, inputType: 'PROJECT', inputId: 'new-context' });
+		f.generation.next({ id: 'obsolete', files: [] });
+		f.generation.complete();
+		expect(s.run()).toBeNull();
+		expect(s.saving()).toBe(false);
+		f.injector.destroy();
