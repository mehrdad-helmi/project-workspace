+				<p-checkbox
+					[inputId]="id()"
+					[formField]="fields.checked"
+					[binary]="true"
+					[indeterminate]="indeterminate()"
+					(onChange)="valueChange.emit($event.checked)"
+				/>
+			}
+			@case ('switch') {
+				<p-toggleswitch
+					[ariaLabel]="ariaLabel() || label()"
+					[inputId]="id()"
+					[formField]="fields.checked"
+					(onChange)="valueChange.emit($event.checked)"
+				/>
+			}
+			@case ('date') {
+				<p-datepicker
+					[inputId]="id()"
+					[formField]="fields.date"
+					[showIcon]="true"
+					[showClear]="true"
+					[fluid]="true"
+					appendTo="body"
+					(onSelect)="dateChanged($event)"
+					(onBlur)="dateChanged(fields.date().value())"
+					(onClear)="valueChange.emit(null)"
+				/>
+			}
+		}
+		@if (control() === 'checkbox' || control() === 'switch') {
+			<label [for]="id()">{{ label() }}</label>
+		}
+		@if (hint() || error()) {
+			<small
+				[id]="descriptionId"
+				[class.error]="!!error()"
+				class="hint"
+				[attr.role]="error() ? 'alert' : null"
+				>{{ error() || hint() }}</small
+			>
+		}
+	</div>`,
+})
+export class OptionsControl {
+	readonly control = input<SemanticControl>('text');
+	readonly value = input<unknown>('');
+	readonly valueChange = output<unknown>();
+	readonly label = input('');
+	readonly ariaLabel = input('');
+	readonly hint = input('');
+	readonly error = input('');
+	readonly id = input(`pl-option-${++nextId}`);
+	readonly required = input(false);
+	readonly disabled = input(false);
+	readonly indeterminate = input(false);
+	readonly multiple = input(false);
+	readonly options = input<readonly ControlChoice[]>([]);
+	readonly minimum = input<number | undefined>();
+	readonly maximum = input<number | undefined>();
+	readonly integer = input(false);
+	readonly suffix = input('');
+	readonly placeholder = input('Choose…');
+	protected readonly descriptionId = `pl-option-description-${nextId}`;
+	protected readonly choices = computed(() => [...this.options()]);
+	private readonly draft = signal({
+		text: '',
+		choice: null as string | number | null,
+		number: null as number | null,
+		checked: false,
+		many: [] as (string | number)[],
+		date: null as Date | null,
+	});
+	protected readonly fields = form(this.draft, (path) =>
+		disabled(path, () => this.disabled()),
+	);
+	constructor() {
+		effect(() => {
+			const value = this.value();
+			untracked(() =>
+				this.draft.set({
+					text: typeof value === 'string' ? value : '',
+					choice:
+						typeof value === 'string' || typeof value === 'number'
+							? value
+							: null,
+					number: typeof value === 'number' ? value : null,
+					checked: value === true,
+					many: Array.isArray(value)
+						? value.filter(
+								(item): item is string | number =>
+									typeof item === 'string' || typeof item === 'number',
+							)
+						: [],
+					date:
+						typeof value === 'string'
+							? DateTime.fromISO(value).toJSDate()
+							: null,
+				}),
+			);
+		});
+	}
+	protected emitText(event: Event): void {
+		this.valueChange.emit(
+			(event.target as HTMLInputElement | HTMLTextAreaElement).value,
+		);
+	}
+	protected dateChanged(value: Date | null): void {
+		this.valueChange.emit(
+			value ? DateTime.fromJSDate(value).toISODate() : null,
+		);
+	}
+}

