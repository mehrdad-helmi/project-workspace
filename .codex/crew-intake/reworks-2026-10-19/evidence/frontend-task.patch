+export class FabricationBatchPage {
+	protected readonly store = inject(FabricationStore);
+	protected readonly projects = inject(ProjectsStore);
+	protected readonly catalog = inject(HubCatalogStore);
+	private readonly router = inject(Router);
+	private readonly confirmations = inject(Confirmations);
+	private readonly assignment = viewChild<Dialog>('assignment');
+	private readonly batchId = toSignal(
+		inject(ActivatedRoute).paramMap.pipe(
+			map((params) => params.get('batchId')),
+		),
+		{ initialValue: null },
+	);
+	protected readonly batch = computed(() => {
+		const batch = this.store.selected();
+		return batch?.id === this.batchId() ? batch : null;
+	});
+	protected readonly searchModel = signal({ query: '' });
+	protected readonly searchForm = form(this.searchModel);
+	protected readonly selectedId = signal<string | null>(null);
+	protected readonly selectedElement = computed(
+		() =>
+			this.batch()?.elements?.find(
+				(element) => element.id === this.selectedId(),
+			) ?? null,
+	);
+	protected readonly assignmentMessage = signal('');
+	protected readonly actionForm = form(signal({ confirmed: true }));
+	protected readonly assignmentModel = signal({ projectId: '' });
+	protected readonly assignmentForm = form(this.assignmentModel, (path) =>
+		required(path.projectId, { message: 'Select a project.' }),
+	);
+	protected readonly assignmentSearchModel = signal({ query: '' });
+	protected readonly assignmentSearchForm = form(this.assignmentSearchModel);
+	protected readonly projectOptions = computed(() =>
+		this.projects.items().map((project) => ({
+			value: project.id,
+			label: `${project.number} · ${project.name}`,
+		})),
+	);
+	protected readonly visibleElements = computed(() => {
+		const query = this.searchModel().query.trim().toLocaleLowerCase();
+		return (this.batch()?.elements ?? []).filter(
+			(element) =>
+				!query ||
+				[
+					element.number,
+					element.description,
+					element.buildingLocation,
+					element.position.name,
+					element.position.number,
+					element.position.project.name,
+				].some((value) => value?.toLocaleLowerCase().includes(query)),
+		);
+	});
+	protected readonly columns: readonly DataTableColumn[] = [
+		{ key: 'number', label: 'Element number' },
+		{ key: 'positionNumber', label: 'Position number' },
+		{ key: 'name', label: 'Position name' },
+		{ key: 'project', label: 'Project' },
+		{ key: 'buildingLocation', label: 'Building location' },
+		{ key: 'included', label: 'Included' },
+	];
+	protected readonly rows = computed<readonly DataTableRow[]>(() =>
+		this.visibleElements().map((element) => ({
+			id: element.id,
+			links: {
+				positionNumber: ['/positions', element.positionId, 'editor'],
+				name: ['/positions', element.positionId, 'editor'],
+			},
+			cells: {
+				number: element.number,
+				positionNumber: element.position.number,
+				name: element.position.name,
+				project: element.position.project.name,
+				buildingLocation: element.buildingLocation,
