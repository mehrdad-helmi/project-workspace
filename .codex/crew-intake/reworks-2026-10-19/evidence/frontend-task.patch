+		s.selectReports(['fixture'], true);
+		s.formats('fixture', ['pdf', 'xlsx']);
+		s.selectElements(['element-1'], true);
+		s.generate();
+		f.generation.next({
+			id: 'run',
+			files: [
+				{
+					id: 'ready',
+					code: 'fixture',
+					format: 'pdf',
+					status: 'ready',
+					filename: 'fixture.pdf',
+					message: null,
+				},
+				{
+					id: 'failed',
+					code: 'fixture',
+					format: 'xlsx',
+					status: 'failed',
