+++ "b/D:\\Planicam\\planicam-frontend\\libs\\shared\\data-access\\src\\lib\\read-all-pages.ts"
@@ -0,0 +1,59 @@
+import type { CollectionPage } from '@planicam/shared/models';
+import { EMPTY, defer, expand, map, reduce, type Observable } from 'rxjs';
+
+/** Complete stable collection through bounded requests. Reject changing/incomplete snapshots instead of hiding records. */
+export function readAllPages<T extends { readonly id: string }>(
+	load: (page: number) => Observable<CollectionPage<T>>,
+): Observable<CollectionPage<T>> {
+	return defer(() => {
+		let total: number | undefined;
+		const checked = (
+			page: CollectionPage<T>,
+			expected: number,
+		): CollectionPage<T> => {
+			if (
+				page.page !== expected ||
+				!Number.isSafeInteger(page.total) ||
+				page.total < 0 ||
+				!Number.isSafeInteger(page.pageSize) ||
+				page.pageSize < 1 ||
+				(page.items.length === 0 &&
+					(expected - 1) * page.pageSize < page.total) ||
+				(total !== undefined && total !== page.total)
+			)
+				throw new Error(
+					'Collection changed or returned an invalid page. Reload it.',
+				);
+			total = page.total;
+			return page;
+		};
+		return load(1).pipe(
+			map((page) => checked(page, 1)),
+			expand((page) =>
+				page.page * page.pageSize < page.total
+					? load(page.page + 1).pipe(
+							map((next) => checked(next, page.page + 1)),
+						)
+					: EMPTY,
+			),
+			reduce((items, page) => {
+				for (const item of page.items) {
+					if (items.has(item.id))
+						throw new Error('Collection changed while loading. Reload it.');
+					items.set(item.id, item);
+				}
+				return items;
+			}, new Map<string, T>()),
+			map((items) => {
+				if (items.size !== total)
+					throw new Error('Incomplete collection response. Reload it.');
+				return {
+					items: [...items.values()],
+					total: items.size,
+					page: 1,
+					pageSize: items.size || 1,
+				};
+			}),
+		);
+	});
+}

