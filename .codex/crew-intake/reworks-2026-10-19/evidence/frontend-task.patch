+		expect(f.downloaded).toEqual([['ready']]);
+		s.retry(['ready', 'failed']);
+		expect(f.retried).toEqual([['failed']]);
+		expect(s.run()?.files[0]?.id).toBe('ready');
+		expect(s.run()?.files.every((file) => file.status === 'ready')).toBe(true);
+		s.anotherSet();
+		expect(s.selectedElementIds()).toEqual([]);
+		expect(s.selectedReportIds()).toEqual([]);
+		expect(s.drafts()).toEqual({});
+		expect(s.staleCodes()).toEqual([]);
+		expect(s.error()).toBeNull();
+		expect(s.run()).toBeNull();
+		s.load({ ...query, inputType: 'PROJECT', inputId: 'different' });
