+		this.assignmentForm().reset({ projectId: '' });
+		this.projects.load({
+			archive: 'active',
+			q: this.assignmentSearchModel().query,
+			sortBy: 'name',
+			sortDirection: 'asc',
+		});
+	}
+	protected async assign(event: Event): Promise<void> {
+		event.preventDefault();
+		await submit(this.assignmentForm, async () => {
+			const batch = this.batch();
+			const projectId = this.assignmentModel().projectId;
+			if (
+				!batch ||
+				batch.archivedAt ||
+				!(await this.confirmations.confirm(
+					'Only active, included, unassigned elements are added. Future elements are not added automatically.',
+					event,
+					true,
+				))
+			)
+				return;
+			if (this.batchId() !== batch.id) return;
+			const result = await firstValueFrom(
+				this.store.assign(batch.id, batch.version, {
+					projectIds: [projectId],
+				}),
+			);
+			if (result.kind === 'success' && this.batchId() === batch.id) {
+				this.assignmentMessage.set(
+					`${result.value.assigned.length} elements added; ${result.value.skipped.length} skipped because they were unavailable, excluded, or already assigned.`,
+				);
+				this.assignment()?.close();
+			}
+		});
+	}
+	protected async remove(element: BatchElement, event: Event): Promise<void> {
+		const batch = this.batch();
+		if (
+			!batch ||
+			!this.canRemove(element) ||
+			!(await this.confirmations.confirm(
+				`Remove ${element.number} from ${batch.name}? The element itself will be preserved.`,
+				event,
+			))
+		)
+			return;
+		if (this.batchId() !== batch.id) return;
+		await submit(this.actionForm, async () => {
+			const result = await firstValueFrom(
+				this.store.unassign(batch.id, element.id, batch.version),
+			);
+			if (result.kind === 'success' && this.batchId() === batch.id)
+				this.selectedId.set(null);
+		});
+	}
+	protected printout(): void {
+		const batch = this.batch();
+		if (batch)
+			void this.router.navigate(['/hub/printouts'], {
+				queryParams: { inputType: 'FABRICATION_BATCH', inputId: batch.id },
+			});
+	}
+}

