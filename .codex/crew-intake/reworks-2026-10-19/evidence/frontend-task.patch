+import {
+	ChangeDetectionStrategy,
+	Component,
+	computed,
+	input,
+	output,
+} from '@angular/core';
+import { disabled, form, FormField, type Field } from '@angular/forms/signals';
+import { signal, effect, untracked } from '@angular/core';
+import { Select as PrimeSelect } from 'primeng/select';
+
+export interface SelectOption {
+	readonly label: string;
+	readonly value: string;
+}
+let nextId = 0;
+@Component({
+	selector: 'pl-select',
+	imports: [PrimeSelect, FormField],
+	changeDetection: ChangeDetectionStrategy.OnPush,
+	host: { '[attr.id]': 'null' },
+	styles:
+		':host {display:block;min-width:0} label {display:grid;gap:7px} small {color:var(--p-red-600)}',
+	template: `<label [for]="id()">
+		@if (label()) {
+			<span>{{ label() }}</span>
+		}
+		<p-select
+			[inputId]="id()"
+			[formField]="control()"
+			[options]="choices()"
+			optionLabel="label"
+			optionValue="value"
+			[placeholder]="placeholder()"
+			[filter]="choices().length > 10"
+			[showClear]="clearable()"
+			[fluid]="true"
+			appendTo="body"
+			[ariaLabel]="label() || ariaLabel() || undefined"
+			[class.p-invalid]="control()().touched() && control()().invalid()"
+			(onChange)="changed($event.value)"
+		/>
+		@if (control()().touched()) {
+			@for (error of control()().errors(); track $index) {
+				<small role="alert">{{ error.message }}</small>
+			}
+		}
+	</label>`,
+})
+export class Select {
+	readonly field = input<Field<string>>();
+	readonly value = input('');
+	readonly valueChange = output<string>();
+	readonly options = input<readonly unknown[]>([]);
+	readonly label = input('');
+	readonly optionLabel = input('label');
+	readonly optionValue = input('value');
+	readonly emptyLabel = input('');
+	readonly ariaLabel = input('');
+	readonly id = input(`pl-select-${++nextId}`);
+	readonly placeholder = input('Choose…');
+	readonly disabled = input(false);
+	readonly clearable = input(false);
+	private readonly draft = signal({ value: '' });
+	private readonly fields = form(this.draft, (path) =>
+		disabled(path, () => this.disabled()),
+	);
+	protected readonly control = computed(() =>
+		this.disabled() ? this.fields.value : (this.field() ?? this.fields.value),
+	);
+	protected readonly choices = computed(() => [
+		...(this.emptyLabel() ? [{ label: this.emptyLabel(), value: '' }] : []),
+		...this.options().map((item) => {
+			if (typeof item === 'string') return { label: item, value: item };
+			const row = item as Readonly<Record<string, unknown>>;
+			return {
+				label: String(row[this.optionLabel()] ?? ''),
+				value: String(row[this.optionValue()] ?? ''),
+			};
+		}),
+	]);
+	constructor() {
+		effect(() => {
+			const value = this.field()?.().value() ?? this.value();
+			untracked(() => this.draft.set({ value }));
+		});
+	}
+	protected changed(value: string | null): void {
+		this.valueChange.emit(value ?? '');
+	}
+}

