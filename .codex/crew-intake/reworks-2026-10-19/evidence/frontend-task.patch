+import { describe, expect, it } from 'bun:test';
+import { firstValueFrom, of } from 'rxjs';
+import { readAllPages } from './read-all-pages';
+
+describe('complete bounded collection loading', () => {
+	it('returns records above the former 100-row cap in stable order', async () => {
+		const items = Array.from({ length: 205 }, (_, index) => ({
+			id: String(index),
+		}));
+		const requested: number[] = [];
+		const result = await firstValueFrom(
+			readAllPages((page) => {
+				requested.push(page);
+				return of({
+					items: items.slice((page - 1) * 100, page * 100),
+					total: 205,
+					page,
+					pageSize: 100,
+				});
+			}),
+		);
+		expect(requested).toEqual([1, 2, 3]);
+		expect(result.items).toEqual(items);
+	});
+	it('rejects changed totals, duplicate identities and incomplete pages', async () => {
+		await expect(
+			firstValueFrom(
+				readAllPages((page) =>
+					of({
+						items: [{ id: String(page) }],
+						total: page === 1 ? 2 : 3,
+						page,
+						pageSize: 1,
+					}),
+				),
+			),
+		).rejects.toThrow();
+		await expect(
+			firstValueFrom(
+				readAllPages((page) =>
+					of({ items: [{ id: 'same' }], total: 2, page, pageSize: 1 }),
+				),
+			),
+		).rejects.toThrow();
+		await expect(
+			firstValueFrom(
+				readAllPages((page) =>
+					of({
+						items: page === 1 ? [{ id: 'one' }] : [],
+						total: 2,
+						page,
+						pageSize: 1,
+					}),
+				),
+			),
+		).rejects.toThrow();
+	});
+});

