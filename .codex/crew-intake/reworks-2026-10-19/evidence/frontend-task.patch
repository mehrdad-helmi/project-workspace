+export type PrintoutFormat = 'pdf' | 'docx' | 'xlsx';
+export type PrintoutControl =
+	| 'text'
+	| 'textarea'
+	| 'number'
+	| 'select'
+	| 'multiSelect'
+	| 'selectButton'
+	| 'checkbox'
+	| 'switch'
+	| 'date';
+export interface PrintoutUiField {
+	readonly path: string;
+	readonly control: PrintoutControl;
+	readonly suffix?: string;
+}
+export interface PrintoutUi {
+	readonly sections: readonly {
+		readonly id: string;
+		readonly label: string;
+		readonly fields: readonly PrintoutUiField[];
+	}[];
+}
+export interface PrintoutDefinition {
+	readonly code: string;
+	readonly definitionVersion: number | null;
+	readonly supportedFormats: readonly PrintoutFormat[];
+	readonly optionsSchema: Readonly<Record<string, unknown>> | null;
+	readonly optionsUi: PrintoutUi | null;
+	readonly initialValues: Readonly<Record<string, unknown>> | null;
+}
+export interface PrintoutFieldError {
+	readonly path: string;
+	readonly keyword: string;
+	readonly message: string;
+}
+export interface PrintoutDraft {
+	readonly definitionVersion: number;
+	readonly options: Readonly<Record<string, unknown>>;
+	readonly formats: readonly PrintoutFormat[];
+}
+export interface PrintoutSubmission {
+	readonly elementIds: readonly string[];
+	readonly printouts: readonly ({ readonly code: string } & PrintoutDraft)[];
+}
+export interface PrintoutValidation {
+	readonly valid: boolean;
+	readonly printouts: readonly {
+		readonly code: string;
+		readonly valid: boolean;
+		readonly errors: readonly PrintoutFieldError[];
+	}[];
+}
+export interface PrintoutElement {
+	readonly id: string;
+	readonly number: string;
+	readonly positionId: string;
+	readonly name: string;
+	readonly type: string;
+	readonly systemId: string;
+	readonly systemName: string;
+	readonly dimensions: string;
+	readonly thumbnailKey: string;
+}
+/** Future adapter contract: a format is one file, success identities are retained during retry. */
+export interface PrintoutFileResult {
+	readonly id: string;
+	readonly code: string;
+	readonly format: PrintoutFormat;
+	readonly status: 'ready' | 'failed';
+	readonly filename: string | null;
+	readonly message: string | null;
+}
+export interface PrintoutRun {
